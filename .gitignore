# Large image artifacts: distributed separately or via Git LFS.
images/*.zst
images/*.tar
images/*.sif

# Generated by the quickstart runners.
quickstart/out/
quickstart/run_out/

# Python build and cache files.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
.pytest_cache/

# Local environments.
.venv/
venv/

# OS and editor files.
.DS_Store
.idea/
.vscode/

# Benchmark results and search intermediates: keep code, not outputs.
supplementary/benchmark/*/predict/*result*/
supplementary/benchmark/*/predict/seed*/
supplementary/benchmark/**/*.fasta

# Generated bootstrap outputs.
supplementary/benchmark/bootstrap_out/

# Downloaded pretrained encoders and Chai-1 assets.
pretrained_weights/

# Local reference copies of upstream sources.
LICENSE_packages/

# Runtime logs.
*.log
